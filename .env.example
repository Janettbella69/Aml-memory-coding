# Coding-track configuration (coding-0.2.0). Copy to .env (never commit .env).
# Values that differ from the textual entry's 1.0.0 are marked "textual: ..."; docs/METHOD_CARD.md has the measurements.
# Required in production: a real secret of >= 16 characters. The evaluator sends it as X-Api-Key
# (also accepted: Authorization: Bearer <key> / Token <key>).
MEMORY_API_KEY=change-me-to-a-long-random-secret
DATA_DIR=/data
RETENTION_DAYS=30
# Ranking knobs for agent transcripts (SWEContextBench, scripts/eval_swecb.py, 2026-10-28)
CONTEXT_WINDOW=0            # textual: 2. Hits are returned alone; the session card supplies the task statement instead
RULE_SLOTS=0                # textual: 6. The standing-rule patterns fire on tool output and documentation text
LEAD_HITS=5
RECENCY_BAND=0              # textual: 0.2. The recording order of past tasks carries no "latest value" meaning
MAX_RESPONSE_CHARS=400000
FALLBACK_RESULTS=10
SWEEP_HOURS=6
# v1.1 coding: identifiers and session cards (app/codeterms.py, search._assemble_cards)
CODE_TERMS=1                # camelCase identifiers are indexed and queried by their inner words too
SESSION_CARDS=1             # results grouped per past session: the session's first turn, then its hits
CARD_HITS=8                 # hit turns per card
CARD_SESSIONS=0             # cards returned; 0 = until top_k / MAX_RESPONSE_CHARS
CARD_TOOL_WEIGHT=0.3        # weight of a non-opening user turn (tool output) in the session score
CARD_CLOSING=1              # a card also carries the session's last assistant turn (the agent's closing message)
# coding-0.2.0: the two gpt-4o-mini calls (open-source rule: gpt-4o-mini only; via OpenRouter the id is openai/gpt-4o-mini,
# the same model routed - set OPENAI_BASE_URL=https://openrouter.ai/api/v1; with an OpenAI key use gpt-4o-mini and the
# default base URL). Both need OPENAI_API_KEY below. Empty = off; any failed call falls back to the deterministic behaviour.
SUMMARY_MODEL=openai/gpt-4o-mini     # Add: one labelled summary turn per request, stored next to the verbatim turns (app/summarize.py)
SUMMARY_CACHE=/data/summary_cache.sqlite   # summaries cached by content digest: a history written again costs nothing (inside the volume)
SUMMARY_TIMEOUT=60
SUMMARY_CHARS=30000
CARD_SELECT_MODEL=openai/gpt-4o-mini # Search: re-orders the leading cards by usefulness for the new task (app/cardselect.py)
CARD_SELECT_MAX=12
CARD_SELECT_TIMEOUT=30
# Concurrency: uvicorn worker processes (one per CPU core) x per-process gates. SQLite serialises allocations
# behind one mutex per process, so FEWER threads per process is faster; scale with workers instead.
UVICORN_WORKERS=2
SEARCH_PARALLELISM=1
WRITE_PARALLELISM=2
# SQLite connection cache per process: memory is bounded by DB_POOL_SIZE x DB_CACHE_KB (128 x 256 KiB = 32 MiB)
DB_POOL_SIZE=128
DB_CACHE_KB=256
DB_IDLE_SECONDS=120
LOG_LEVEL=INFO
# Deployment behind another proxy (deploy/tencent): the host IP the container port is published on.
BIND_IP=172.17.0.1

# v0.3 query planner: OFF in the coding configuration (textual: gpt-4o-mini; measured on the coding proxy it lowers the
# first rank). Empty PLANNER_MODEL = no planner. OPENAI_API_KEY / OPENAI_BASE_URL serve the summariser and the card
# selector above as well.
PLANNER_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=gpt-4o-mini
PLANNER_MAX_QUERIES=3
PLANNER_TIMEOUT=20
PLANNER_SNIPPETS=8

# v0.4 rendering and options (see app/timex.py, app/search.py)
TIME_NOTES=0                # textual: 1. Relative-time notes are rendering only; transcripts do not need them
OPTIONS_MODE=append         # the coding track sends no options; kept for the textual code path
OPTIONS_WEIGHT=0.6

# v0.5 dense channel: OFF in the coding configuration (textual: text-embedding-v4). Empty EMBED_MODEL = lexical only.
# Open-source rule when enabled: text-embedding-v4 only.
EMBED_MODEL=
EMBED_DIMS=256
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_RPS=14
EMBED_TIMEOUT=30
DENSE_WEIGHT=1.0
DENSE_HEAD=5
VECTOR_CACHE_USERS=64

# v0.6 evidence selector (one gpt-4o-mini call per Search, after retrieval). Empty = off.
SELECTOR_MODEL=
SELECTOR_CANDIDATES=40
SELECTOR_MAX_SELECT=8
SELECTOR_TAIL=-1
SELECTOR_BLOCK_CHARS=1200
SELECTOR_TIMEOUT=20
SELECTOR_MIN_RESULTS=12

# v0.7 cross-encoder reranker (rerankers are unrestricted). Empty = off (off in both entries).
RERANK_PROVIDER=dashscope
RERANK_MODEL=
RERANK_CANDIDATES=40
RERANK_MODE=replace
RERANK_TIMEOUT=20
RERANK_DOC_CHARS=1500
RERANK_DOC=both
RERANK_MIN_RESULTS=6

# v0.8 fit mode (textual, off) and v0.9 final cut (off)
FIT_CHARS=0
FIT_FILL=0.8
FIT_SPAN_MIN=800
FIT_ANCHORS=8
RETURN_CHARS=0
RETURN_FROM_CHARS=0
