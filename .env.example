# Copy to .env (never commit .env). Required in production: a real secret of >= 16 characters.
# The evaluator sends it as X-Api-Key (also accepted: Authorization: Bearer <key> / Token <key>).
MEMORY_API_KEY=change-me-to-a-long-random-secret
DATA_DIR=/data
RETENTION_DAYS=30
# Ranking knobs (defaults chosen by scripts/sweep_local.py on 2026-10-07)
CONTEXT_WINDOW=2
RULE_SLOTS=6
LEAD_HITS=5
RECENCY_BAND=0.2
MAX_RESPONSE_CHARS=400000
FALLBACK_RESULTS=10
SWEEP_HOURS=6
# Concurrency: uvicorn worker processes (one per CPU core) × per-process gates. SQLite serialises allocations
# behind one mutex per process, so FEWER threads per process is faster; scale with workers instead.
UVICORN_WORKERS=2
SEARCH_PARALLELISM=1
WRITE_PARALLELISM=2
# SQLite connection cache per process: memory is bounded by DB_POOL_SIZE x DB_CACHE_KB (128 x 256 KiB = 32 MiB)
DB_POOL_SIZE=128
DB_CACHE_KB=256
DB_IDLE_SECONDS=120
LOG_LEVEL=INFO
# v0.3 query planner: ON in the submitted configuration (open-source rule: gpt-4o-mini only).
# Empty PLANNER_MODEL = deterministic pipeline. OPENAI_BASE_URL is optional (OpenAI-compatible proxies);
# via OpenRouter use OPENAI_BASE_URL=https://openrouter.ai/api/v1 and the model id openai/gpt-4o-mini
# (same OpenAI model, routed). JUDGE_MODEL is only read by scripts/judge_local.py.
PLANNER_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4o-mini
PLANNER_MAX_QUERIES=3
PLANNER_TIMEOUT=20
PLANNER_SNIPPETS=8

# v0.4 rendering and options (see app/timex.py, app/search.py)
TIME_NOTES=1
OPTIONS_MODE=append
OPTIONS_WEIGHT=0.6

# v0.5 dense channel (academic-board rule: text-embedding-v4 only). Empty EMBED_MODEL = lexical + planner only.
EMBED_MODEL=text-embedding-v4
EMBED_DIMS=256
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_RPS=14
EMBED_TIMEOUT=30
DENSE_WEIGHT=1.0
DENSE_HEAD=5
VECTOR_CACHE_USERS=64

# v0.6 evidence selector (a reranker over our own blocks; one gpt-4o-mini call per Search, after retrieval).
# Moves the blocks that hold evidence to the front; for 'fact' questions the unselected tail may be cut.
# Empty = off. Needs OPENAI_API_KEY (+ OPENAI_BASE_URL for OpenRouter, model id openai/gpt-4o-mini there).
SELECTOR_MODEL=
SELECTOR_CANDIDATES=40      # leading blocks shown to the selector
SELECTOR_MAX_SELECT=8       # blocks it may move to the front
SELECTOR_TAIL=-1            # 'fact' questions: unselected blocks kept after the selected ones; -1 = keep all (reorder only)
SELECTOR_BLOCK_CHARS=1200   # characters of each block shown to the selector
SELECTOR_TIMEOUT=20
SELECTOR_MIN_RESULTS=12     # shorter lists are returned untouched

# v0.7 cross-encoder reranker (academic-board rules: rerankers are unrestricted). One rerank-API call per Search over the
# first RERANK_CANDIDATES blocks; replace = reranker order for that head, rrf = fused with the retrieval rank. Empty = off.
# Providers: dashscope (gte-rerank-v2 | qwen3-rerank, DASHSCOPE_API_KEY), voyage (rerank-2.5, VOYAGE_API_KEY),
# cohere (rerank-v3.5 | rerank-4-pro, COHERE_API_KEY), jina (jina-reranker-v3, JINA_API_KEY). RERANK_API_KEY overrides.
# OFF in the submitted configuration (2026-10-15): with the organisers' answer prompt and judge, on top of the dense channel
# and the planner, qwen3.7-text-rerank moved the evidence to rank 1 but not accuracy (LoCoMo-Refined 0.704 = 0.704;
# LongMemEval-S 0.633 -> 0.583, knowledge-update 0.80 -> 0.50: replace mode drops the newest-first order those questions
# need). The 2026-10-09 gain (qwen3-rerank 0.819 vs 0.778) used our local judge prompt on a lexical base and did not carry
# over. Set a model to enable; docs/METHOD_CARD.md 0.10 has the numbers.
RERANK_PROVIDER=dashscope
RERANK_MODEL=
RERANK_CANDIDATES=40
RERANK_MODE=replace
RERANK_TIMEOUT=20
RERANK_DOC_CHARS=1500
# What the reranker scores per result: both = the matched turn, then its span (default) | hit = the turn alone | block = the span.
# Evidence at rank 1, retrieval only: LoCoMo-Refined (344 q) none 0.58 · hit 0.63 · block 0.85 · both 0.84; LongMemEval-S (42 q) 0.64 · 0.74 · 0.48 · 0.83.
RERANK_DOC=both
RERANK_MIN_RESULTS=6

# v0.8 fit mode. When a user's whole stored text is at most FIT_CHARS characters, Search returns all of it as at most
# top_k contiguous segments in relevance order instead of hit ± CONTEXT_WINDOW blocks. 0 = off (default until measured on
# LoCoMo-Refined and LongMemEval; see PLAN.md).
FIT_CHARS=0
FIT_FILL=0.8        # share of the top_k slots the segmentation aims to use
FIT_SPAN_MIN=800    # smallest segment, in rendered characters
FIT_ANCHORS=8       # leading hits that get a segment centred on them

# v0.9 final cut after the reranker/selector: whole blocks up to RETURN_CHARS characters, standing rules kept. 0 = off.
# Measured 2026-10-15 with the organisers' answer + judge prompts (scripts/eval_length.py): cuts of 20k–60k characters
# did not help on LoCoMo-Refined and hurt on LongMemEval-S, so the whole list goes out. RETURN_FROM_CHARS limits the cut
# to users whose stored text is larger than that (0 = every user).
RETURN_CHARS=0
RETURN_FROM_CHARS=0
